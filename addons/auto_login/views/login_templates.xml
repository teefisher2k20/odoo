<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_layout_clean" inherit_id="web.login_layout">
        <!-- Remove the footer with "Manage Databases" and "Powered by Odoo" -->
        <xpath expr="//div[hasclass('text-center', 'small', 'mt-4', 'pt-3', 'border-top')]" position="replace">
            <div class="text-center small mt-4 pt-3 border-top">
                <!-- Content removed -->
            </div>
        </xpath>
    </template>
</odoo>
