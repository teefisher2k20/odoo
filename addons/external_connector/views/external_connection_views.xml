<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_external_connection_form" model="ir.ui.view">
        <field name="name">external.connection.form</field>
        <field name="model">external.connection</field>
        <field name="arch" type="xml">
            <form string="External Connection">
                <header>
                    <button name="test_connection" string="Test Connection" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="connection_type"/>
                    </group>

                    <group string="Database Details" attrs="{'invisible': [('connection_type', 'not in', ('mysql', 'mssql'))]}">
                        <field name="host"/>
                        <field name="port"/>
                        <field name="user"/>
                        <field name="password" password="True"/>
                        <field name="db_name"/>
                    </group>

                    <group string="Google Sheets Details" attrs="{'invisible': [('connection_type', '!=', 'google_sheets')]}">
                        <field name="google_json_key"/>
                        <field name="spreadsheet_url"/>
                    </group>

                    <group string="Excel Details" attrs="{'invisible': [('connection_type', '!=', 'excel')]}">
                        <field name="excel_filename" invisible="1"/>
                        <field name="excel_file" filename="excel_filename"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_external_connection_tree" model="ir.ui.view">
        <field name="name">external.connection.tree</field>
        <field name="model">external.connection</field>
        <field name="arch" type="xml">
            <tree string="External Connections">
                <field name="name"/>
                <field name="connection_type"/>
                <field name="host"/>
            </tree>
        </field>
    </record>

    <record id="action_external_connection" model="ir.actions.act_window">
        <field name="name">Data Sources</field>
        <field name="res_model">external.connection</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
